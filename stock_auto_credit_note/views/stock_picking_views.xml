<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_inherit_credit_note" model="ir.ui.view">
        <field name="name">stock.picking.form.credit.note</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Smart button: show posted invoice count on original outgoing delivery -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="picking_type_code != 'outgoing' or invoice_count == 0">
                    <field name="invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
